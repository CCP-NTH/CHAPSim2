private  subroutine parse_iviscous (input_line, iviscous) Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: input_line integer, intent(out) :: iviscous private  subroutine parse_LES_model (input_line, LES_model) Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: input_line integer, intent(out) :: LES_model private  subroutine parse_gravity_vector (line, gravity_vector) Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: line real(kind=WP), intent(out) :: gravity_vector (NDIM) public  subroutine Read_input_parameters () Reading the input parameters from the given file.\nScope:  mpi    called-freq    xdomain\n        all    once           all\n- none (in): NA\n- none (out): NA\nRead, validate, and distribute all input parameters. Read more… Arguments None private  subroutine apply_case_geometry_defaults (dm) \\brief Restore the case-driven geometry defaults on one domain. Read more… Arguments Type Intent Optional Attributes Name type( t_domain ), intent(inout) :: dm private  subroutine apply_mesh_stretching_defaults (dm) \\brief Apply the mesh-count and stretching defaults on one domain. Read more… Arguments Type Intent Optional Attributes Name type( t_domain ), intent(inout) :: dm public  subroutine Read_input_parameters_target (dm, flinput) \\brief Read the target-mesh description used by the mesh-mapping pre-run. Read more… Arguments Type Intent Optional Attributes Name type( t_domain ), intent(inout) :: dm character(len=*), intent(in) :: flinput","tags":"","url":"module/input_general_mod.html"},{"title":"apx_prerun_mod – CHAPSim2","text":"Approximate pre-run estimates for DNS mesh and time-step suitability. The routines in this module provide empirical checks for wall-bounded cases,\nincluding approximate skin-friction estimates, wall-unit spacing, Hartmann\nlayer spacing, and CFL-related time-step guidance. Uses math_mod input_general_mod parameters_constant_mod mpi_mod wtformat_mod Variables Type Visibility Attributes Name Initial real(kind=WP), public, parameter :: dxplus_max = 10.0_WP real(kind=WP), public, parameter :: dzplus_max = 5.0_WP real(kind=WP), public, parameter :: dyplus_max = 1.0_WP real(kind=WP), public, parameter :: Cflmax = 0.714_WP real(kind=WP), public, parameter :: Ctmmax = 0.1_WP real(kind=WP), public, save :: dymax real(kind=WP), public, save :: dymin real(kind=WP), public, save :: rmin real(kind=WP), public, save :: rmax real(kind=WP), public, save :: Re_tau real(kind=WP), public, save :: u_tau Functions private pure function local_growth_rate (dya, dyb) Arguments Type Intent Optional Attributes Name real(kind=WP), intent(in) :: dya real(kind=WP), intent(in) :: dyb Return Value real(kind=wp) private pure function count_points_near_wall (y, wall, dist) Arguments Type Intent Optional Attributes Name real(kind=WP), intent(in) :: y (:) real(kind=WP), intent(in) :: wall real(kind=WP), intent(in) :: dist Return Value integer Subroutines private  subroutine solve_Prandtl_vonKarman_eq_for_cf (cf, Re, icase) Arguments Type Intent Optional Attributes Name real(kind=WP), intent(out) :: cf real(kind=WP), intent(in) :: Re integer, intent(in) :: icase private  subroutine estimate_skin_friction_factor (cf, Re, icase) Arguments Type Intent Optional Attributes Name real(kind=WP), intent(out) :: cf real(kind=WP), intent(in) :: Re integer, intent(in) :: icase private  subroutine estimate_friction_and_retau (fl, dm, cf_skin, f_darcy, Re_corr) Arguments Type Intent Optional Attributes Name type( t_flow ), intent(in) :: fl type( t_domain ), intent(in) :: dm real(kind=WP), intent(out) :: cf_skin real(kind=WP), intent(out) :: f_darcy real(kind=WP), intent(out) :: Re_corr public  subroutine estimate_spacial_resolution (fl, dm, opt_mh) Estimate whether the current mesh is adequate for wall-bounded DNS.\n- fl (in): Flow configuration.\n- dm (in): Domain and mesh descriptor.\n- opt_mh (in): Optional MHD configuration for Hartmann-layer checks. Arguments Type Intent Optional Attributes Name type( t_flow ), intent(in) :: fl type( t_domain ), intent(in) :: dm type( t_mhd ), intent(in), optional :: opt_mh public  subroutine estimate_temporal_resolution (fl, dm) Estimate time-step and CFL suitability before a production run.\n- fl (in): Flow configuration.\n- dm (in): Domain and mesh descriptor. Arguments Type Intent Optional Attributes Name type( t_flow ), intent(in) :: fl type( t_domain ), intent(in) :: dm","tags":"","url":"module/apx_prerun_mod.html"},{"title":"flow_gradient_mod – CHAPSim2","text":"Cell-centred velocity and physical velocity-gradient tensor. Both the turbulence statistics (statistics_mod) and the LES subgrid models\n(les_mod) need the same object: u_i and du_i/dx_j interpolated to the cell\ncentre, expressed in physical components. Keeping one copy here avoids the\ntwo implementations drifting apart, as they had done: the LES copy carried\nonly the Cartesian assembly and silently returned the wrong tensor in a pipe. Uses udf_type_mod precision_mod Subroutines public  subroutine get_velocity_and_gradient_ccc (fl, dm, dudx, opt_uccc) Build the cell-centred velocity and the physical velocity-gradient tensor. Read more… Arguments Type Intent Optional Attributes Name type( t_flow ), intent(in) :: fl type( t_domain ), intent(in) :: dm real(kind=WP), intent(out) :: dudx (:,:,:,:,:) real(kind=WP), intent(out), optional :: opt_uccc (:,:,:,:)","tags":"","url":"module/flow_gradient_mod.html"},{"title":"convert_primary_conservative_mod – CHAPSim2","text":"Subroutines public  subroutine convert_primary_conservative (dm, dens, itag, iloc, qx, qy, qz, gx, gy, gz) Arguments Type Intent Optional Attributes Name type( t_domain ), intent(inout) :: dm real(kind=WP), intent(in), dimension( dm%dccc%xsz(1), dm%dccc%xsz(2), dm%dccc%xsz(3)) :: dens integer, intent(in) :: itag integer, intent(in) :: iloc real(kind=WP), intent(inout), optional, dimension( dm%dpcc%xsz(1), dm%dpcc%xsz(2), dm%dpcc%xsz(3)) :: qx real(kind