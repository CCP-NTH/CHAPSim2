' , 'Get_x_midp_C2P_1D' ) case ( IBC_NEUMANN ) call reduce_bc_to_interp ( ibc ( i ), flg_wrn_xmidp_c2p_neumann ( i ), 'IBC_NEUMANN' , 'Get_x_midp_C2P_1D' ) end select end if end do ixsub = dm % idom nsz = size ( fo ) fo = ZERO dp ( 1 ) = dm % h ( 1 ) dp ( 3 ) = dm % h ( 1 ) * THREE dp ( 2 ) = dm % h ( 1 ) dp ( 4 ) = dm % h ( 1 ) * THREE if ( present ( fbc )) then call Prepare_TDMA_interp_C2P_RHS_array ( fi (:), fo (:), nsz , m1rC2P ( 1 : NL , 1 : 2 * NS , NBCS : NBCE , iacc ), ibc (:), opt_fbc = fbc (:), opt_dp = dp (:)) else call Prepare_TDMA_interp_C2P_RHS_array ( fi (:), fo (:), nsz , m1rC2P ( 1 : NL , 1 : 2 * NS , NBCS : NBCE , iacc ), ibc (:), opt_dp = dp (:)) end if if ( iacc == IACCU_CP4 . or . iacc == IACCU_CP6 ) then if ( ibc ( 1 ) == IBC_PERIODIC ) then is_periodic = . true . else is_periodic = . false . end if call Solve_TDMA ( is_periodic , fo (:), & xtdma_lhs ( ixsub )% am1x_C2P (:, ibc ( 1 ), ibc ( 2 ), iacc ), & xtdma_lhs ( ixsub )% bm1x_C2P (:, ibc ( 1 ), ibc ( 2 ), iacc ), & xtdma_lhs ( ixsub )% cm1x_C2P (:, ibc ( 1 ), ibc ( 2 ), iacc ), & xtdma_lhs ( ixsub )% dm2x_C2P (:, ibc ( 1 ), ibc ( 2 ), iacc ), & nsz ) end if #ifdef DEBUG_ALGO do i = 1 , NL write ( * , '(A, 3I3.1, 5F7.3)' ) 'm1fC2P, bc, acc, ln, lhs, rhs:' , ibc ( 1 ), iacc , i , m1fC2P ( i , 1 : 3 , ibc ( 1 ), iacc ), & m1rC2P ( i , 1 : 2 , ibc ( 1 ), iacc ) end do #endif return end subroutine Get_x_midp_C2P_1D","tags":"","url":"proc/get_x_midp_c2p_1d.html"},{"title":"Get_x_midp_P2C_1D – CHAPSim2","text":"private  subroutine Get_x_midp_P2C_1D(fi, fo, dm, iacc, ibc0, fbc) Uses parameters_constant_mod udf_type_mod tridiagonal_matrix_algorithm Arguments Type Intent Optional Attributes Name real(kind=WP), intent(in) :: fi (:) real(kind=WP), intent(out) :: fo (:) type( t_domain ), intent(in) :: dm integer, intent(in) :: iacc integer, intent(in) :: ibc0 (2) real(kind=WP), intent(in), optional :: fbc (4) Source Code subroutine Get_x_midp_P2C_1D ( fi , fo , dm , iacc , ibc0 , fbc ) use parameters_c