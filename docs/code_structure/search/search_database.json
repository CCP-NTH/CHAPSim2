 (in): Domain descriptor. Arguments Type Intent Optional Attributes Name type( t_thermo ), intent(inout) :: tm type( t_domain ), intent(in) :: dm private  subroutine Generate_random_field (fl, dm) Generate a flow profile for Poiseuille flow in channel or pipe.\nScope:  mpi    called-freq    xdomain     module\n        all    once           specified   private\nGenerate a random perturbation field for flow initialisation.\n- fl (inout): Flow state receiving random perturbations.\n- dm (in): Domain descriptor. Arguments Type Intent Optional Attributes Name type( t_flow ), intent(inout) :: fl type( t_domain ), intent(in) :: dm private  subroutine Generate_poiseuille_flow_profile (dm, u_xy) Generate a flow profile for Poiseuille flow in channel or pipe.\nScope:  mpi    called-freq    xdomain     module\n        all    once           specified   private\n- d (in): domain\n- ux_1c1 (out): u(yc), velocity profile along wall-normal direction Arguments Type Intent Optional Attributes Name type( t_domain ), intent(in) :: dm real(kind=WP), intent(out) :: u_xy (:,:) private  subroutine initialise_poiseuille_flow (fl, dm) initialise Poiseuille flow in channel or pipe.\nScope:  mpi    called-freq    xdomain     module\n        all    once           specified   private\n- d (in): domain\n- f (out): flow Arguments Type Intent Optional Attributes Name type( t_flow ), intent(inout) :: fl type( t_domain ), intent(inout) :: dm private  subroutine initialise_flow_from_given_values (fl) Arguments Type Intent Optional Attributes Name type( t_flow ), intent(inout) :: fl private  subroutine initialise_solid_body_rotation (fl, dm) Initialise a cylindrical domain with rigid-body rotation about the axis,\noptionally superposed on a uniform axial velocity: Read more… Arguments Type Intent Optional Attributes Name type( t_flow ), intent(inout) :: fl type( t_domain ), intent(in) :: dm public  subroutine initialise_flow_from_given_inlet (fl, dm) Arguments Type Intent Optional Attributes Name type( t_flow ), intent(inout) :: fl type( t_domain ), intent(in) :: dm public  subroutine initialise_flow_fields (fl, dm, opt_tm) Initialise all flow fields according to the selected input mode.\n- fl (inout): Flow state to initialise.\n- dm (inout): Domain descriptor. Arguments Type Intent Optional Attributes Name type( t_flow ), intent(inout) :: fl type( t_domain ), intent(inout) :: dm type( t_thermo ), intent(inout), optional :: opt_tm public  subroutine initialise_thermo_fields (tm, fl, dm) Initialise all thermal fields according to the selected input mode.\n- tm (inout): Thermal state to initialise.\n- fl (inout): Flow state coupled to thermal properties.\n- dm (inout): Domain descriptor. Arguments Type Intent Optional Attributes Name type( t_thermo ), intent(inout) :: tm type( t_flow ), intent(inout) :: fl type( t_domain ), intent(inout) :: dm private  subroutine initialise_vortexgreen_2dflow (fl, dm) initialise Vortex Green flow Read more… Arguments Type Intent Optional Attributes Name type( t_flow ), intent(inout) :: fl type( t_domain ), intent(in) :: dm public  subroutine Validate_TGV2D_error (fl, dm) Arguments Type Intent Optional Attributes Name type( t_flow ), intent(in) :: fl type( t_domain ), intent(in) :: dm private  subroutine initialise_vortexgreen_3dflow (fl, dm) initialise Vortex Green flow Read more… Arguments Type Intent Optional Attributes Name type( t_flow ), intent(inout) :: fl type( t_domain ), intent(in) :: dm private  subroutine initialise_vortexgreen_3dflow_thermo (fl, tm, dm) Arguments Type Intent Optional Attributes Name type( t_flow ), intent(inout) :: fl type( t_thermo ), intent(inout) :: tm type( t_domain ), intent(in) :: dm","tags":"","url":"module/flow_thermo_initialiasation.html"},{"title":"regression_test_mod – CHAPSim2","text":"Regression-test metric container and JSON writer. Provides the compact metric set consumed by the shell regression tests and\nwrites rank-0 JSON files for comparison against reference values. Uses precision_mod Variables Type Visibility Attributes Name Initial real(kind=WP), private, save :: sgs_coef_face_min = huge(1.0_WP) real(kind=WP), private, save :: sgs_visc_face_min = huge(1.0_WP) real(kind=WP), private, save :: sgs_wall_coef_peak = 0.0_WP real(kind=WP), private, save :: sgs_inout_coef_peak = 0.0_WP real(kind=WP), private, save :: sgs_enth_flux_peak = 0.0_WP integer, private, save :: n_sgs_coef_face_calls = 0 integer, private, save :: n_sgs_visc_face_calls = 0 integer, private, save :: n_sgs_coef_bc_calls = 0 integer, private, save :: n_sgs_enth_flux_calls = 0 Derived Types type, public :: t_metrics Scalar diagnostics used by smoke and regression tests. Components Type Visibility Attributes Name Initial real(kind=wp), public :: mass_balance real(kind=wp), public :: mass_residual (3) real(kind=wp), public :: projected_mass_residual (3) real(kind=wp), public :: physical_poisson_compatibility_defect real(kind=wp), public :: uniform_poisson_source_correction real(kind=wp), public :: poisson_projected_source_amplitude real(kind=wp), public :: poisson_zero_mode_rhs_projection real(kind=wp), public :: total_mass real(kind=wp), public :: total_mass_drift real(kind=wp), public :: kinetic_energy real(kind=wp), public :: bulk_velocity (3) real(kind=wp), public :: mean_dpdx real(kind=wp), public :: pressure_drop real(kind=wp), public :: bulk_massflux (3) real(kind=wp), public :: bulk_enthalpy real(kind=wp), public :: bulk_temperature real(kind=wp), public :: max_div_j real(kind=wp), public :: current_imbalance real(kind=wp), public :: max_strain_rate_mag2_init real(kind=wp), public :: sgs_coef_face_min real(kind=wp), public :: sgs_visc_face_min real(kind=wp), public :: sgs_wall_coef_peak real(kind=wp), public :: sgs_inout_coef_peak real(kind=wp), public :: sgs_enthalpy_flux_peak Subroutines public  subroutine record_sgs_enthalpy_flux (arr) Record the peak magnitude of an assembled subgrid enthalpy flux component.\n- arr (in): face-located c_sgs * dh/dx_i. Arguments Type Intent Optional Attributes Name real(kind=WP), intent(in) :: arr (:,:,:) public  subroutine record_sgs_coef_face (arr) Record the minimum of an interpolated subgrid coefficient on a face set.\n- arr (in): face-located subgrid coefficient. Arguments Type Intent Optional Attributes Name real(kind=WP), intent(in) :: arr (:,:,:) public  subroutine record_sgs_visc_face (arr) Record the minimum of a total (molecular + subgrid) face viscosity.\n- arr (in): face-located viscosity ratio mu/mu0. Arguments Type Intent Optional Attributes Name real(kind=WP), intent(in) :: arr (:,:,:) public  subroutine record_sgs_coef_bc (arr, idir, ibc_sgs) Record the subgrid coefficient on the two physical boundary planes of a\nface set, classified by the coefficient boundary codes. Read more… Arguments Type Intent Optional Attributes Name real(kind=WP), intent(in) :: arr (:,:,:) integer, intent(in) :: idir integer, intent(in) :: ibc_sgs (2) public  subroutine reduce_sgs_diagnostics (metrics, is_thermo) Reduce the subgrid diagnostics across ranks and copy them into the metrics.\n- metrics (inout): metric container to fill.\n- is_thermo (in): require the enthalpy-flux gate to have sampled as well. Arguments Type Intent Optional Attributes Name type( t_metrics ), intent(inout) :: metrics logical, intent(in) :: is_thermo public  subroutine write_metrics_json (filename, metrics, is_thermo, is_mhd, is_les) Write regression metrics to a JSON file on rank 0.\n- filename (in): Output JSON file name.\n- metrics (in): Metrics to write.\n- is_thermo (in): Include thermal metrics when true.\n- is_mhd (in): Include MHD charge-conservation metrics when true.\n- is_les (in): Include LES metrics when true. Arguments Type Intent Optional Attributes Name character(len=*), intent(in) :: filename type( t_metrics ), intent(in) :: metrics logical, intent(in) :: is_thermo logical, intent(in) :: is_mhd logical, intent(in) :: is_les private  subroutine write_json_real (unit, key, value, last) Arguments Type Intent Optiona