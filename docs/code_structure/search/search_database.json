!!!!!!!!!!!!!!!!!!!!!!!!!!!! subroutine decomp_2d_poisson_finalize implicit none if ( allocated ( ax )) deallocate ( ax ) if ( allocated ( bx )) deallocate ( bx ) if ( allocated ( ay )) deallocate ( ay ) if ( allocated ( by )) deallocate ( by ) if ( allocated ( az )) deallocate ( az ) if ( allocated ( bz )) deallocate ( bz ) call decomp_info_finalize ( ph ) call decomp_info_finalize ( sp ) call decomp_2d_fft_finalize fft_initialised = . false . if ( allocated ( kxyz )) deallocate ( kxyz ) if ( bcx == 0 . and . bcy == 0 . and . bcz == 0 ) then if ( allocated ( cw1 )) deallocate ( cw1 ) if ( allocated ( a )) deallocate ( a ) if ( allocated ( a2 )) deallocate ( a2 ) if ( allocated ( a3 )) deallocate ( a3 ) else if ( bcx == 1 . and . bcy == 0 . and . bcz == 0 ) then if ( allocated ( cw1 )) deallocate ( cw1 ) if ( allocated ( cw1b )) deallocate ( cw1b ) if ( allocated ( rw1 )) deallocate ( rw1 ) if ( allocated ( rw1b )) deallocate ( rw1b ) if ( allocated ( rw2 )) deallocate ( rw2 ) if ( allocated ( a )) deallocate ( a ) if ( allocated ( a2 )) deallocate ( a2 ) if ( allocated ( a3 )) deallocate ( a3 ) else if ( bcx == 0 . and . bcy == 1 . and . bcz == 0 ) then if ( allocated ( cw1 )) deallocate ( cw1 ) if ( allocated ( cw2 )) deallocate ( cw2 ) if ( allocated ( cw22 )) deallocate ( cw22 ) if ( allocated ( cw2b )) deallocate ( cw2b ) if ( allocated ( cw2c )) deallocate ( cw2c ) if ( allocated ( rw2 )) deallocate ( rw2 ) if ( allocated ( rw2b )) deallocate ( rw2b ) if ( allocated ( a )) deallocate ( a ) if ( allocated ( a2 )) deallocate ( a2 ) if ( allocated ( a3 )) deallocate ( a3 ) else if ( bcx == 1 . and . bcy == 1 ) then if ( allocated ( cw1 )) deallocate ( cw1 ) if ( allocated ( cw1b )) deallocate ( cw1b ) if ( allocated ( cw2 )) deallocate ( cw2 ) if ( allocated ( cw22 )) deallocate ( cw22 ) if ( allocated ( cw2b )) deallocate ( cw2b ) if ( allocated ( cw2c )) deallocate ( cw2c ) if ( allocated ( rw1 )) deallocate ( rw1 ) if ( allocated ( rw1b )) deallocate ( rw1b ) 