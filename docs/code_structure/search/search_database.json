sion(:, :, :, :) :: opt_acccn2 real(kind=WP), intent(in), optional, dimension(:, :, :, :) :: opt_acccn3 real(kind=WP), intent(in), optional, dimension(:, :, :) :: opt_accc0 character(len=*), intent(in), optional :: opt_visnm integer, intent(in), optional :: opt_nstat","tags":"","url":"proc/run_stats_loops10.html"},{"title":"run_stats_loops45 – CHAPSim2","text":"private  subroutine run_stats_loops45(mode, acccn_tavg, field_name, iter, dm, opt_ndudusz, opt_acccnn1, opt_acccnn2, opt_accc0, opt_visnm, opt_nstat) Uses typeconvert_mod udf_type_mod Arguments Type Intent Optional Attributes Name integer, intent(in) :: mode real(kind=WP), intent(inout), dimension(:, :, :, :) :: acccn_tavg character(len=*), intent(in) :: field_name integer, intent(in) :: iter type( t_domain ), intent(in) :: dm integer, intent(in), optional :: opt_ndudusz real(kind=WP), intent(in), optional, dimension(:, :, :, :, :) :: opt_acccnn1 real(kind=WP), intent(in), optional, dimension(:, :, :, :, :) :: opt_acccnn2 real(kind=WP), intent(in), optional, dimension(:, :, :) :: opt_accc0 character(len=*), intent(in), optional :: opt_visnm integer, intent(in), optional :: opt_nstat","tags":"","url":"proc/run_stats_loops45.html"},{"title":"init_spectrum_uu – CHAPSim2","text":"private  subroutine init_spectrum_uu(fl, dm) Uses udf_type_mod Arguments Type Intent Optional Attributes Name type( t_flow ), intent(inout) :: fl type( t_domain ), intent(in) :: dm","tags":"","url":"proc/init_spectrum_uu.html"},{"title":"accumulate_spectrum_uu – CHAPSim2","text":"private  subroutine accumulate_spectrum_uu(fl, dm, uccc) Uses mpi_mod udf_type_mod transpose_extended_mod Arguments Type Intent Optional Attributes Name type( t_flow ), intent(inout) :: fl type( t_domain ), intent(in) :: dm real(kind=WP), intent(in) :: uccc (dm%dccc%xsz(1),dm%dccc%xsz(2),dm%dccc%xsz(3),3)","tags":"","url":"proc/accumulate_spectrum_uu.html"},{"title":"accumulate_spectrum_dir – CHAPSim2","text":"private  subroutine accumulate_spectrum_dir(uprime, nfft, wsave, spec, fft_dim) Arguments Type Intent Optional Attributes Name real(kind=WP), intent(in) :: uprime (:,:,:) integer, intent(in) :: nfft real(kind=WP), intent(inout) :: wsave (:) real(kind=WP), intent(inout) :: spec (:,:) integer, intent(in) :: fft_dim","tags":"","url":"proc/accumulate_spectrum_dir.html"},{"title":"write_spectrum_uu – CHAPSim2","text":"private  subroutine write_spectrum_uu(fl, dm) Uses udf_type_mod Arguments Type Intent Optional Attributes Name type( t_flow ), intent(in) :: fl type( t_domain ), intent(in) :: dm","tags":"","url":"proc/write_spectrum_uu.html"},{"title":"write_spectrum_bundle_uu – CHAPSim2","text":"private  subroutine write_spectrum_bundle_uu(fl, dm) Uses io_tools_mod io_files_mod udf_type_mod Arguments Type Intent Optional Attributes Name type( t_flow ), intent(in) :: fl type( t_domain ), intent(in) :: dm Source Code subroutine write_spectrum_bundle_uu ( fl , dm ) use io_files_mod use io_tools_mod use udf_type_mod implicit none type ( t_flow ), intent ( in ) :: fl type ( t_domain ), intent ( in ) :: dm character ( 256 ) :: output_files ( 1 ) integer :: unit_s logical :: do_write unit_s = - 1 call generate_pathfile_name ( output_files ( 1 ), dm % idom , 'spectrum' , dir_data , 'dat' , fl % iteration ) call prepare_output_file_set ( output_files , dm % existing_output_policy , 'spectrum bundle' , do_write ) if (. not . do_write ) return if ( nrank == 0 ) then open ( newunit = unit_s , file = trim ( output_files ( 1 )), action = 'write' , status = 'replace' ) write ( unit_s , '(A)' ) '# CHAPSim_spectrum_bundle_v1' write ( unit_s , '(A,1X,I0)' ) '# domain' , dm % idom write ( unit_s , '(A,1X,I0)' ) '# iter' , fl % iteration write ( unit_s , '(A,1X,I0)' ) '# samples' , fl % nspec_samples write ( unit_s , '(A,1X,I0)' ) '# window_first_iter' , fl % nspec_istart write ( unit_s , '(A)' ) '# columns: k_index  y_index  k  y  yplus  E  kE' end if if ( allocated ( fl % spec_uu_kx )) & call write_spectrum_file ( fl % spec_uu_kx , dm , fl , 'spectrum_uu_kx' , dm % nc ( 1 ), dm % nc ( 3 ), & dm % dccc % xst ( 2 ), dm % lxx , opt_unit = unit_s , & opt_component = 'uu' , opt_direction = 'kx' ) if ( allocated ( fl % spec_uu_kz )) & call write_spectrum_file ( fl % spec_uu_kz , dm , fl , 'spectrum_uu_kz' , dm % nc ( 3 ), dm % nc ( 1 ), & dm % dccc % zst ( 2 ), dm % lzz , opt_unit = unit_s , & opt_component = 'uu' , opt_direction = 'kz' ) if ( nrank == 0 ) close ( unit_s ) return end subroutine write_spectrum_bundle_uu","tags":"","url":"proc/write_spectrum_bundle_uu.html"},{"title":"write_spectrum_file – CHAPSim2","text":"private  subroutine write_spectrum_file(spec_local, dm, fl, keyword, nfft, nline_avg, yst_local, length_dir, opt_unit, opt_component, opt_direction) Uses mpi_mod io_tools_mod io_files_mod udf_type_mod Arguments Type Intent Optional Attributes Name real(kind=WP), intent(in) :: spec_local (:,:) type( t_domain ), intent(in) :: dm type( t_flow ), intent(in) :: fl character(len=*), intent(in) :: keyword integer, intent(in) :: nfft integer, intent(in) :: nline_avg integer, intent(in) :: yst_local real(kind=WP), intent(in) :: length_dir integer, intent(in), optional :: opt_unit character(len=*), intent(in), optional :: opt_component character(len=*), intent(in), optional :: opt_direction","tags":"","url":"proc/write_spectrum_file.html"},{"title":"init_stats_flow – CHAPSim2","text":"public  subroutine init_stats_flow(fl, dm) Uses io_tools_mod typeconvert_mod parameters_constant_mod udf_type_mod Arguments Type Intent Optional Attributes Name type( t_flow ), intent(inout) :: fl type( t_domain ), intent(in) :: dm","tags":"","url":"proc/init_stats_flow.html"},{"title":"init_stats_thermo – CHAPSim2","text":"public  subroutine init_stats_thermo(tm, dm) Uses io_tools_mod parameters_constant_mod udf_type_mod Arguments Type Intent Optional Attributes Name type( t_thermo ), intent(inout) :: tm type( t_domain ), intent(in) :: dm","tags":"","url":"proc/init_stats_thermo.html"},{"title":"init_stats_mhd – CHAPSim2","text":"public  subroutine init_stats_mhd(mh, fl, dm) Uses io_tools_mod parameters_constant_mod udf_type_mod Arguments Type Intent Optional Attributes Name type( t_mhd ), intent(inout) :: mh type( t_flow ), intent(in) :: fl type( t_domain ), intent(in) :: dm","tags":"","url":"proc/init_stats_mhd.html"},{"title":"update_stats_flow – CHAPSim2","text":"public  subroutine update_stats_flow(fl, dm, tm, mh) Uses parameters_constant_mod udf_type_mod flow_gradient_mod Arguments Type Intent Optional Attributes Name type( t_flow ), intent(inout) :: fl type( t_domain ), intent(in) :: dm type( t_thermo ), intent(in), optional :: tm type( t_mhd ), intent(in), optional :: mh","tags":"","url":"proc/update_stats_flow.html"},{"title":"update_stats_thermo – CHAPSim2","text":"public  subroutine update_stats_thermo(tm, dm) Uses parameters_constant_mod operations transpose_extended_mod udf_type_mod Arguments Type Intent Optional Attributes Name type( t_thermo ), intent(inout) :: tm type( t_domain ), intent(in) :: dm","tags":"","url":"proc/update_stats_thermo.html"},{"title":"update_stats_mhd – CHAPSim2","text":"public  subroutine update_stats_mhd(mh, fl, dm) Uses operations udf_type_mod parameters_constant_mod transpose_extended_mod cylindrical_rn_mod Arguments Type Intent Optional Attributes Name type( t_mhd ), intent(inout) :: mh type( t_flow ), intent(inout) :: fl type( t_domain ), intent(in) :: dm","tags":"","url":"proc/update_stats_mhd.html"},{"title":"write_stats_flow – CHAPSim2","text":"public  subroutine write_stats_flow(fl, dm) Uses io_tools_mod typeconvert_mod udf_type_mod Arguments Type Intent Optional Attributes Name type( t_flow ), intent(inout) :: fl type( t_domain ), intent(in) :: dm","tags":"","url":"proc/write_stats_flow.html"},{"title":"write_stats_thermo – CHAPSim2","text":"public  subroutine write_stats_thermo(tm, dm) Uses io_tools_mod udf_type_mod Arguments Type Intent Optional Attributes Name type( t_thermo ), intent(inout) :: tm type( t_domain ), intent(in) :