t(in) :: dm_tgt real(kind=WP), intent(in) :: xsrc (:) real(kind=WP), intent(in) :: ysrc (:) real(kind=WP), intent(in) :: zsrc (:) real(kind=WP), intent(in) :: fsrc (:,:,:) real(kind=WP), intent(inout) :: ftgt (:,:,:) type(DECOMP_INFO), intent(in) :: dsrc type(DECOMP_INFO), intent(in) :: dtmp integer, intent(in) :: xloc_tgt integer, intent(in) :: yloc_tgt integer, intent(in) :: zloc_tgt integer, intent(in) :: extend_mode_x real(kind=WP), intent(in) :: extend_length_x integer, intent(in) :: extend_mode_z real(kind=WP), intent(in) :: extend_length_z private  subroutine configure_interp_target_domain (dm_src, dm_tgt) Give the target domain everything the restart writers read off it. Read more… Arguments Type Intent Optional Attributes Name type( t_domain ), intent(in) :: dm_src type( t_domain ), intent(inout) :: dm_tgt private  subroutine allocate_interp_target_variables (fl_tgt, tm_tgt, dm_tgt) Allocate the target field set the restart writers touch. Read more… Arguments Type Intent Optional Attributes Name type( t_flow ), intent(inout) :: fl_tgt type( t_thermo ), intent(inout) :: tm_tgt type( t_domain ), intent(inout) :: dm_tgt private  subroutine interp_fbcx_plane_generic (dm_tgt, ysrc, zsrc, fsrc, ftgt, dsrc, dtgt, yloc_tgt, zloc_tgt, extend_mode_z, extend_length_z) Remap one x-boundary plane set onto the target cross-section. Read more… Arguments Type Intent Optional Attributes Name type( t_domain ), intent(in) :: dm_tgt real(kind=WP), intent(in) :: ysrc (:) real(kind=WP), intent(in) :: zsrc (:) real(kind=WP), intent(in) :: fsrc (:,:,:) real(kind=WP), intent(inout) :: ftgt (:,:,:) type(DECOMP_INFO), intent(in) :: dsrc type(DECOMP_INFO), intent(in) :: dtgt integer, intent(in) :: yloc_tgt integer, intent(in) :: zloc_tgt integer, intent(in) :: extend_mode_z real(kind=WP), intent(in) :: extend_length_z private  subroutine interp_fbcx_history_plane (dm_tgt, ysrc, zsrc, hsrc, htgt, dsrc, dtgt, yloc_tgt, zloc_tgt, extend_mode_z, extend_length_z) Remap a single-layer x-boundary history plane, stored as a bare (y, z) array. Read more… Arguments Type Intent Optional Attributes Name type( t_domain ), intent(in) :: dm_tgt real(kind=WP), intent(in) :: ysrc (:) real(kind=WP), intent(in) :: zsrc (:) real(kind=WP), intent(in) :: hsrc (:,:) real(kind=WP), intent(inout) :: htgt (:,:) type(DECOMP_INFO), intent(in) :: dsrc type(DECOMP_INFO), intent(in) :: dtgt integer, intent(in) :: yloc_tgt integer, intent(in) :: zloc_tgt integer, intent(in) :: extend_mode_z real(kind=WP), intent(in) :: extend_length_z private  subroutine build_up_interp_target_xoutlet_state (dm_src, fl_src, dm_tgt, fl_tgt) Carry the stored convective-outlet state across to the target mesh. Read more… Arguments Type Intent Optional Attributes Name type( t_domain ), intent(in) :: dm_src type( t_flow ), intent(in) :: fl_src type( t_domain ), intent(inout) :: dm_tgt type( t_flow ), intent(inout) :: fl_tgt public  subroutine output_interp_target_field (dm_src, fl_src, tm_src) Driver for writing interpolated target restart fields.\n- dm_src (in): Source domain descriptor.\n- fl_src (in): Source flow field.\n- tm_src (in): Source thermal field. Arguments Type Intent Optional Attributes Name type( t_domain ), intent(in) :: dm_src type( t_flow ), intent(in) :: fl_src type( t_thermo ), intent(in), optional :: tm_src","tags":"","url":"module/io_field_interpolation_mod.html"},{"title":"eq_momentum_mod – CHAPSim2","text":"Momentum-equation solver and pressure-correction workflow. This module assembles convective/diffusive/source terms, advances the\nfractional-step momentum equations, solves pressure correction, and enforces\nmass-flux consistency for the active domain geometry. Uses decomp_2d operations precision_mod print_msg_mod wrt_debug_field_mod Subroutines private  subroutine fill_fbcz_from_cc_uniform (fbcz_cc4, fbcz_s4, name) Fill a z-boundary 4-plane buffer for an x- or y-staggered location from the\ncell-centred z-boundary property plane. Read more… Arguments Type Intent Optional Attributes Name real(kind=WP), intent(in) :: fbcz_cc4 (:,:,:) real(kind=WP), intent(out) :: fbcz_s4 (:,:,:) character(len=*), intent(in) :: name private  subroutine gravity_decomposition_to_rz (dens, fgravity_yz, fr_cpc_ypencil, ft_ccp_zpencil, dm) Decompose Cartesian gravity forcing into cylindrical radial/azimuthal components.\n- dens (in): Density field.\n- fgravity_yz (in): Cartesian y/z gravity components.\n- fr_cpc_ypencil (out): Radial force component on cpc layout.\n- ft_ccp_zpencil (out): Azimuthal force component on ccp layout.\n- dm (in): Domain descriptor. Arguments Type Intent Optional Attributes Name real(kind=WP), intent(in), dimension(dm%dccc%xsz(1), dm%dccc%xsz(2), dm%dccc%xsz(3)) :: dens real(kind=WP), intent(in) :: fgravity_yz (2:3) real(kind=WP), intent(out), dimension(dm%dcpc%ysz(1), dm%dcpc%ysz(2), dm%dcpc%ysz(3)) :: fr_cpc_ypencil real(kind=WP), intent(out), dimension(dm%dccp%zsz(1), dm%dccp%zsz(2), dm%dccp%zsz(3)) :: ft_ccp_zpencil type( t_domain ), intent(in) :: dm private  subroutine Calculate_momentum_fractional_step (rhs0, rhs1, rhs1_pfc, dtmp, dm, isub) To calcuate the convection and diffusion terms in rhs of momentum eq. Read more… Arguments Type Intent Optional Attributes Name real(kind=WP), intent(inout), dimension(dtmp%xsz(1), dtmp%xsz(2), dtmp%xsz(3)) :: rhs0 real(kind=WP), intent(inout), dimension(dtmp%xsz(1), dtmp%xsz(2), dtmp%xsz(3)) :: rhs1 real(kind=WP), intent(inout), dimension(dtmp%xsz(1), dtmp%xsz(2), dtmp%xsz(3)) :: rhs1_pfc type(DECOMP_INFO), intent(in) :: dtmp type( t_domain ), intent(in) :: dm integer, intent(in) :: isub private  subroutine Compute_momentum_rhs (fl, dm, isub, opt_dens, opt_visc, opt_visc_sgs) To calcuate all rhs of momentum eq. Arguments Type Intent Optional Attributes Name type( t_flow ), intent(inout) :: fl type( t_domain ), intent(inout) :: dm integer, intent(in) :: isub real(kind=WP), intent(in), optional, dimension(dm%dccc%xsz(1), dm%dccc%xsz(2), dm%dccc%xsz(3)) :: opt_dens real(kind=WP), intent(in), optional, dimension(dm%dccc%xsz(1), dm%dccc%xsz(2), dm%dccc%xsz(3)) :: opt_visc real(kind=WP), intent(in), optional, dimension(dm%dccc%xsz(1), dm%dccc%xsz(2), dm%dccc%xsz(3)) :: opt_visc_sgs private  subroutine Correct_massflux (fl, phi_ccc, dm, isub) Arguments Type Intent Optional Attributes Name type( t_flow ), intent(inout) :: fl real(kind=WP), intent(in), dimension( dm%dccc%xsz(1), dm%dccc%xsz(2), dm%dccc%xsz(3) ) :: phi_ccc type( t_domain ), intent(in) :: dm integer, intent(in) :: isub private  subroutine solve_pressure_poisson (fl, dm, isub) Arguments Type Intent Optional Attributes Name type( t_flow ), intent(inout) :: fl type( t_domain ), intent(in) :: dm integer, intent(in) :: isub public  subroutine Solve_momentum_eq (fl, dm, isub) To update the provisional u or rho u. Read more… Arguments Type Intent Optional Attributes Name type( t_flow ), intent(inout) :: fl type( t_domain ), intent(inout) :: dm integer, intent(in) :: isub","tags":"","url":"module/eq_momentum_mod.html"},{"title":"solver_tools_mod – CHAPSim2","text":"Functions public  function Get_pipe_active_tripping_factor (fl) result(ftrip) Return the active-tripping amplitude factor based on solver iteration count. Arguments Type Intent Optional Attributes Name type( t_flow ), intent(in) :: fl Return Value real(kind=WP) public pure function is_RK_proj (isub) result(d) Arguments Type Intent Optional Attributes Name integer, intent(in) :: isub Return Value logical Subroutines public  subroutine Apply_pipe_active_tripping (fl, dm, amp_scale, relax_time) Apply the cylindrical active-tripping perturbation to the current velocity field. Read more… Arguments Type Intent Optional Attributes Name type( t_flow ), intent(inout) :: fl type( t_domain ), intent(inout) :: dm real(kind=WP), intent(in) :: amp_scale real(kind=WP), intent(in) :: relax_time public  subroutine Update_Re (iter, fl) The main code for initialising flow variables\nThis subroutine is called once in initialise_chapsim. Arguments Type Intent Optional Attributes Name integer, intent(in) :: iter type( t_flow ), intent(inout) :: fl public  subroutine Update_PrGr (fl, tm) Arguments Type Intent Optional Attributes Name type( t_flow ), intent(inout) :: fl type( t_thermo ), intent(inout) :: tm public  subroutine Calculate_vis_sponge (fl, dm) Arguments Type Intent Optional Attributes Name type( t_flow ), intent(inout) :: fl type( t_domain ), intent(in) :: dm public  subroutine Adjust_to_xzmean_zero (var, dtmp, n, varxz) The main code for initialising flow variables Read more… Arguments Type Intent Optional Attributes Name real(kind=WP), intent(inout), dimension(dtmp%xsz(1), dtmp%xsz(2), dtmp%xsz(3)) :: var type(DECOMP_INFO), intent(in) :: dtmp integer, intent(in) :: n real(kind=WP), intent(in), dimension(n) :: varxz public  subroutine Check_cfl_diffusion (fl, dm, opt_tm) Arguments Type Intent Optional Attributes Name type( t_flow ), intent(in) :: fl type( t_domain ), intent(in) :: dm type( t_thermo ), intent(in), optional :: opt_tm public  subroutine Check_cfl_convection (u, v, w, dm) to check CFL for convection terms\nCFL = u&#94;x/dx + v&#94;y/dy + w&#94;z/dz < limit\nMPI : x-pencil\n (y) &#94; _ | |_____|______|\n     |_____|_____|______| > (z) Arguments Type Intent Optional Attributes Name real(kind=WP), intent(in), dimension(dm%dpcc%xsz(1), dm%dpcc%xsz(2), dm%dpcc%xsz(3)) :: u real(kind=WP), intent(in), dimension(dm%dcpc%xsz(1), dm%dcpc%xsz(2), dm%dcpc%xsz(3)) :: v real(kind=WP), intent(in), dimension(dm%dccp%xsz(1), dm%dccp%xsz(2), dm%dccp%xsz(3)) :: w type( t_domain ), intent(inout) :: dm public  subroutine get_fbcx_ftp_4pc (fbcx_ftp_4cc, fbcx_ftp_4pc, dm) to calculate:\n         fo = integral over x and z directions\n This is based only y-direction stretching.\n TODO: Here is 2nd order Trapezoid Method. Need to improve! Check!\n Scope:  mpi    called-freq    xdomain     module\n         all    needed         specified   pubic\n MPI :\n     default x-pencil\n     working in : y-pencil\n  (y) &#94; _ | |_____|______|\n      |_____|_____|______| > (z)\n Y: index arrangment\n      j'-1   j'-1  j'    j'+1  j'+2\n      _| . | . | . | . | . j-2   j-1   j     j+1    j+2 Arguments Type Intent Optional Attributes Name real(kind=WP), intent(in), dimension(dm%d4cc%xsz(1), dm%d4cc%xsz(2), dm%d4cc%xsz(3)) :: fbcx_ftp_4cc real(kind=WP), intent(out), dimension(dm%d4pc%xsz(1), dm%d4pc%xsz(2), dm%d4pc%xsz(3)) :: fbcx_ftp_4pc type( t_domain ), intent(in) :: dm public  subroutine check_global_mass_balance (mass_imbalance, drhodt, dm) Arguments Type Intent Optional Attributes Name real(kind=WP), intent(out) :: mass_imbalance (8) real(kind=WP), intent(in), dimension(:,:,:) :: drhodt type( t_domain ), intent(in) :: dm public  subroutine damping_drhodt (accc_xpencil, dm) Arguments Type Intent Optional Attributes Name real(kind=WP), intent(inout) :: accc_xpencil (:,:,:) type( t_domain ), intent(in) :: dm","tags":"","url":"module/solver_tools_mod.html"},{"title":"les_mod – CHAPSim2","text":"Uses udf_type_mod decomp_2d operations precision_mod Subroutines private  subroutine calculate_strain_rate_tensor (velocity_gradient, strain_rate) Form the resolved strain-rate tensor S_ij = 0.5*(du_i/dx_j + du_j/dx_i).\n- velocity_gradient: cell-centred velocity-gradient tensor.\n- strain_rate: output symmetric strain-rate tensor. Arguments Type Intent Optional Attributes Name real(kind=WP), intent(in) :: velocity_gradient (:,:,:,:,:) real(kind=WP), intent(out) :: strain_rate (:,:,:,:,:) private  subroutine calculate_strain_rate_magnitude_square (strain_rate, strain_rate_mag2) Compute S_ij S_ij at each cell centre.\n- strain_rate: resolved strain-rate tensor.\n- strain_rate_mag2: output tensor contraction S_ij S_ij. Arguments Type Intent Optional Attributes Name real(kind=WP), intent(in) :: strain_rate (:,:,:,:,:) real(kind=WP), intent(out) :: strain_rate_mag2 (:,:,:) private  subroutine calculate_wale_tensor (velocity_gradient, wale_tensor) Compute the traceless symmetric square-gradient tensor used by the WALE model.\n- velocity_gradient: cell-centred velocity-gradient tensor.\n- wale_tensor: output S&#94;d_ij tensor. Arguments Type Intent Optional Attributes Name real(kind=WP), intent(in) :: velocity_gradient (:,:,:,:,:) real(kind=WP), intent(out) :: wale_tensor (:,:,:,:,:) private  subroutine calculate_wale_tensor_magnitude_square (wale_tensor, wale_tensor_mag2) Compute S&#94;d_ij S&#94;d_ij at each cell centre.\n- wale_tensor: WALE traceless symmetric square-gradient tensor.\n- wale_tensor_mag2: output tensor contraction S&#94;d_ij S&#94;d_ij. Arguments Type Intent Optional Attributes Name real(kind=WP), intent(in) :: wale_tensor (:,:,:,:,:) real(kind=WP), intent(out) :: wale_tensor_mag2 (:,:,:) private  subroutine calculate_eddy_viscosity_wale (dm, strain_rate_mag2, wale_tensor_mag2, eddy_visc_kinematic) Evaluate the WALE kinematic eddy viscosity from strain and WALE invariants.\n- dm: domain descriptor used for grid spacing.\n- strain_rate_mag2: S_ij S_ij field.\n- wale_tensor_mag2: S&#94;d_ij S&#94;d_ij field.\n- eddy_visc_kinematic: output nondimensional kinematic eddy viscosity. Arguments Type Intent Optional Attributes Name type( t_domain ), intent(in) :: dm real(kind=WP), intent(in) :: strain_rate_mag2 (:,:,:) real(kind=WP), intent(in) :: wale_tensor_mag2 (:,:,:) real(kind=WP), intent(out) :: eddy_visc_kinematic (:,:,:) public  subroutine calculate_les_wale (fl, dm, opt_max_strain_rate_mag2) Calculate turbulent dynamic viscosity using the WALE LES model.\n- fl: flow state; fl%tVisc is overwritten with turbulent dynamic viscosity.\n- dm: domain/decomposition and boundary-condition metadata.\n- opt_max_strain_rate_mag2: optional global max of S_ij S_ij. The reduction is a\n  collective, so it is only performed when the caller asks for it - the timestep\n  loop does not, and pays nothing. Arguments Type Intent Optional Attributes Name type( t_flow ), intent(inout) :: fl type( t_domain ), intent(in) :: dm real(kind=WP), intent(out), optional :: opt_max_strain_rate_mag2","tags":"","url":"module/les_mod.html"},{"title":"checkpoint_metadata_mod – CHAPSim2","text":"Shared text metadata helpers for restartable checkpoint outputs. Uses io_tools_mod io_files_mod print_msg_mod parameters_constant_mod Subroutines public  subroutine write_checkpoint_manifest (idom, iter, time, dt) Arguments Type Intent Optional Attributes Name integer, intent(in) :: idom integer, intent(in) :: iter real(kind=WP), intent(in) :: time real(kind=WP), intent(in) :: dt private  subroutine write_checkpoint_manifest_entry (u, idom, group_name, iter) Arguments Type Intent Optional Attributes Name integer, intent(in) :: u integer, intent(in) :: idom character(len=*), intent(in) :: group_name integer, intent(in) :: iter public  subroutine read_checkpoint_metadata (idom, iter, time, dt, found) Arguments Type Intent Optional Attributes Name integer, intent(in) :: idom integer, intent(in) :: iter real(kind=WP), intent(out) :: time real(kind=WP), intent(out) :: dt logical, intent(out) :: found","tags":"","url":"module/checkpoint_metadata_mod.html"},{"title":"domain_decomposition_mod – CHAPSim2","text":"Uses mpi_mod decomp_2d Subroutines public  subroutine initialise_domain_decomposition (dm) domain decompistion.\nScope:  mpi    called-freq    xdomain     module\n        all    once           specified   priviate\n- d (in): domain type Arguments Type Intent Optional Attributes Name type( t_domain ), intent(inout) :: dm public  subroutine Buildup_mpi_domain_decomposition () domain decompistion.\nScope:  mpi    called-freq    xdomain   module\n        all    once           all       public\n- none (in): NA Arguments None","tags":"","url":"module/domain_decomposition_mod.html"},{"title":"continuity_eq_mod – CHAPSim2","text":"Divergence and mass-conservation diagnostics. Provides divergence operators for flow and generic vector fields, including\nsupport for staggered decompositions and element-wise mass-conservation\nchecks used by monitor and debug output. Uses decomp_2d operations Subroutines public  subroutine Get_divergence_flow (fl, div, dm) To calculate divergence of (rho * u) or divergence of (u)\n- div (out): div(q) or div(g)\n- d (in): domain\nCompute divergence of the active flow mass-flux or velocity field.\n- fl (in): Flow state containing velocity or mass-flux components.\n- div (out): Divergence field on cell centres.\n- dm (in): Domain descriptor. Arguments Type Intent Optional Attributes Name type( t_flow ), intent(in) :: fl real(kind=WP), intent(out), dimension(dm%dccc%xsz(1), dm%dccc%xsz(2), dm%dccc%xsz(3)) :: div type( t_domain ), intent(in) :: dm public  subroutine Get_divergence_vector (ux, uy, uz, div, dm, opt_fbcx, opt_fbcy, opt_fbcz) To calculate divergence of (rho * u) or divergence of (u)\n- ux (in): ux or gx\n- uy (in): uy or gy\n- uz (in): uz or gz\n- div (out): div(u) or div(g)\n- d (in): domain\nCompute divergence of vector components on staggered layouts.\n- ux (in): x-component on x-staggered layout.\n- uy (in): y-component on y-staggered layout.\n- uz (in): z-component on z-staggered layout.\n- div (out): Divergence field on cell centres.\n- dm (in): Domain descriptor.\n- opt_fbcx/opt_fbcy/opt_fbcz (in): Boundary planes of the vector being\n  differenced. Optional; the velocity planes are used when they are absent. Arguments Type Intent Optional Attributes Name real(kind=WP), intent(in), dimension(dm%dpcc%xsz(1), dm%dpcc%xsz(2), dm%dpcc%xsz(3)) :: ux real(kind=WP), intent(in), dimension(dm%dcpc%xsz(1), dm%dcpc%xsz(2), dm%dcpc%xsz(3)) :: uy real(kind=WP), intent(in), dimension(dm%dccp%xsz(1), dm%dccp%xsz(2), dm%dccp%xsz(3)) :: uz real(kind=WP), intent(out), dimension(dm%dccc%xsz(1), dm%dccc%xsz(2), dm%dccc%xsz(3)) :: div type( t_domain ), intent(in) :: dm real(kind=WP), intent(in), optional, dimension(             4, dm%dpcc%xsz(2), dm%dpcc%xsz(3)) :: opt_fbcx real(kind=WP), intent(in), optional, dimension(dm%dcpc%ysz(1),              4, dm%dcpc%ysz(3)) :: opt_fbcy real(kind=WP), intent(in